# Supabase 프로젝트 설정 → API 메뉴에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 멀티테넌트 — company.code (예: dkmetal). api_key 는 넣지 말 것.
COMPANY_CODE=dkmetal
# 브라우저 번들에서 getCompanyId() 가 동작하려면 동일 값으로 설정
NEXT_PUBLIC_COMPANY_CODE=dkmetal

# AI 자동판정 (Claude Vision)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 카카오 알림톡 (솔라피) — 비어 있으면 발송 스킵
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
KAKAO_CHANNEL_PFID=
# 선택: 문자 대체발송용 사전등록 발신번호 (없으면 알림톡만, disableSms)
# SOLAPI_SENDER=
# Vercel Cron /api/cron/auto-notify 보호용
CRON_SECRET=

# 디케이메탈 MES 작업자 연동 (Vercel 서버 전용)
# 서버 루트 주소를 지정합니다. 개발 주소를 생략하면 같은 서버의 개발 경로를 사용합니다.
MES_WORKER_SYNC_BASE_URL=
MES_WORKER_SYNC_DEV_BASE_URL=
# IIS MobileMaterials__WorkerSync__Secret과 같은 32바이트 이상 임의 비밀값
MES_WORKER_SYNC_SECRET=
# 기존 관리자 서버의 Supabase service_role 키
SUPABASE_SERVICE_ROLE_KEY=

# 근태 엑셀 메일 (Resend) — 비어 있으면 발송 스킵
# RESEND_API_KEY=
# MAIL_FROM=noreply@your-domain.com

# 문서 지식베이스 임베딩 (Voyage AI) — 서버 전용
VOYAGE_API_KEY=
